#!/bin/sh

set -u
set -e
trap onexit INT
trap onexit TERM
trap onexit EXIT

TMPDIR=

onexit()
{
	if [ ! "$TMPDIR" = "" ]; then
		rm -rf $TMPDIR
	fi
}

if [ -f libjpeg-turbo-3.2.0.aarch64.rpm ]; then
	rm -f libjpeg-turbo-3.2.0.aarch64.rpm
fi

umask 022
TMPDIR=`mktemp -d /tmp/libjpeg-turbo-build.XXXXXX`

mkdir -p $TMPDIR/RPMS
ln -fs `pwd` $TMPDIR/BUILD
rpmbuild -bb --define "_blddir $TMPDIR/buildroot" --define "_topdir $TMPDIR" \
	--define "__strip /usr/bin/aarch64-linux-gnu-strip" --target aarch64 pkgscripts/rpm.spec; \
cp $TMPDIR/RPMS/aarch64/libjpeg-turbo-3.2.0-20261025.aarch64.rpm \
	libjpeg-turbo-3.2.0.aarch64.rpm
