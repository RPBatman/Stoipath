{
  "note": "the schema error is reported once, by review-recorded",
  "base": "base.module.json",
  "patch": [
    {
      "op": "replace",
      "path": "/metadata/review",
      "value": {
        "status": "reviewed",
        "date": "2026-11-04"
      }
    }
  ],
  "expect": [
    {
      "rule": "review-recorded",
      "severity": "error",
      "path": "/metadata/review",
      "message": "Reviewed, but the reviewer's name or the review date is missing"
    }
  ],
  "alsoAllowed": []
}
