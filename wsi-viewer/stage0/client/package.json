{
  "name": "stoipath-wsi-stage0-client",
  "private": true,
  "version": "0.0.1",
  "description": "Stage-0 whole-slide image viewer prototype: WebGL2 tile renderer that measures its own zoom/pan latency and sharpness.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --host",
    "serve": "node harness/serve.mjs",
    "harness": "node harness/run.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "~7.3.7"
  }
}
